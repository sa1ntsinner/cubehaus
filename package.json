{
  "name": "cubehaus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "e2e": "pnpm -r --if-present run e2e",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:crates": "node scripts/check-crate-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/*.md",
      "!!node_modules",
      "!!pnpm-lock.yaml",
      "!!**/dist",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!packages/algs/src/data",
      "!!packages/algs/src/candidates/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}

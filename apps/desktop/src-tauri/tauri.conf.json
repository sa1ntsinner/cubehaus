{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cubehaus",
  "version": "1.0.0",
  "identifier": "app.cubehaus.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "cubehaus",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A speedcubing timer",
    "license": "MPL-2.0",
    "homepage": "https://github.com/sa1ntsinner/cubehaus",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0OENGMUU1MTFCREQ0NjIKUldSaTFMMFI1ZkdNdEZJOXhpbmpDdlpobFRYbkxBdXllL0FtTnBWOUFoRVIwbEdzZENpcE5oNnAK",
      "endpoints": [
        "https://github.com/sa1ntsinner/cubehaus/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
